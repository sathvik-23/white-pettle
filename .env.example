# Copy to .env.local for local runs. On Google Cloud these live in Secret Manager as WHITEPETAL_<NAME>
# (set them with infra/secrets.sh NAME). Leave a key empty and that feature is simply off.

# ---------- AI engines and the writer ----------
# FREE: Google Gemini (aistudio.google.com/apikey). Live engine with Google Search grounding + all AI writing
GEMINI_API_KEY=
# FREE: Groq (console.groq.com/keys). Live engine with web search + a fast writer
GROQ_API_KEY=
# Paid, optional: ChatGPT and Perplexity as live engines
OPENAI_API_KEY=
PERPLEXITY_API_KEY=
ANTHROPIC_API_KEY=
# Optional: force the writing model: gemini | groq | openai | anthropic
# PETTLE_LLM_PROVIDER=gemini

# ---------- Google AI Overviews + AI Mode, and live Google rankings (pick one) ----------
# DataForSEO (pay as you go, ~$0.002 per search; preferred when both are set)
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# SerpApi (free tier: 250 searches/month)
SERPAPI_KEY=

# ---------- Accounts, database, scheduled checks ----------
# Postgres. Without it the app runs with no accounts and keeps everything in the browser.
# Local: postgres://whitepetal:whitepetal@127.0.0.1:5432/whitepetal  (docker compose up db)
DATABASE_URL=
# Signs sessions and encrypts integration keys at rest. 32+ random characters: openssl rand -hex 32
APP_SECRET=
# Cloud Scheduler sends this in x-cron-secret to POST /api/cron/tick
CRON_SECRET=
# Optional invite code: when set, sign-up without an invite link asks for it (invited people never need it)
ACCESS_CODE=
# The people who run White Petal (comma-separated emails): they create organisations for clients and can open any
# organisation as an admin. Every such visit is written to that organisation's audit log.
PLATFORM_OPERATORS=
# Set to 0 so new self-serve accounts bring their own AI keys instead of using the platform's (default: they may)
# PLATFORM_KEYS_FOR_SIGNUPS=0
# Set to "open" to let anyone create extra organisations (default: operators only)
# ORG_CREATION=open

# ---------- Email (invites, password resets) ----------
# Resend (resend.com). Without a key nothing is sent: links are logged, and admins see the invite link to copy.
RESEND_API_KEY=
EMAIL_FROM=White Petal <no-reply@whitepetal.perfstaq.com>
# Public URL, used for OAuth redirects and links in Slack messages
PUBLIC_ORIGIN=http://localhost:3000

# ---------- Integrations ----------
# Google Search Console + GA4: an OAuth "Web application" client from console.cloud.google.com/apis/credentials
# Redirect URIs: <PUBLIC_ORIGIN>/api/oauth/google/callback (Search Console) and <PUBLIC_ORIGIN>/api/auth/google/callback (Sign in with Google)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# FREE: Knowledge Graph Search API key (entity check). Same Google Cloud project, "API key"
GOOGLE_API_KEY=
# Bing Webmaster, IndexNow, Cloudflare and Slack are connected per brand in Settings, not here.

# ---------- Paid plans (Razorpay) ----------
# Off by default. 0: no checkout (everyone keeps their access); operators: White Petal operators only;
# 1: owners/admins may subscribe, and new self-serve sign-ups start a seven-day Growth trial.
BILLING_ENABLED=0
# Razorpay API keys and webhook secret. Use TEST keys locally (rzp_test_...). On Google Cloud these are secrets:
# infra/secrets.sh RAZORPAY_KEY_SECRET. The key id is the only one the browser ever sees.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Monthly Razorpay plan ids (not secret) for each self-serve plan and currency. Prices live in server/plans.mjs and
# must match the Razorpay plans: Starter 4900/499900, Growth 9900/999900, Agency 24900/2499900 (cents/paise).
RAZORPAY_PLAN_STARTER_USD=
RAZORPAY_PLAN_STARTER_INR=
RAZORPAY_PLAN_GROWTH_USD=
RAZORPAY_PLAN_GROWTH_INR=
RAZORPAY_PLAN_AGENCY_USD=
RAZORPAY_PLAN_AGENCY_INR=
# Optional: trial and grace lengths in days (defaults 7 and 3)
# BILLING_TRIAL_DAYS=7
# BILLING_GRACE_DAYS=3
