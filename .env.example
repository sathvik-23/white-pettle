# Copy to .env.local for local runs. On Google Cloud these live in Secret Manager as WHITEPETAL_<NAME>
# (set them with infra/secrets.sh NAME). Leave a key empty and that feature is simply off.

# ---------- AI engines and the writer ----------
# FREE: Google Gemini (aistudio.google.com/apikey). Live engine with Google Search grounding + all AI writing
GEMINI_API_KEY=
# FREE: Groq (console.groq.com/keys). Live engine with web search + a fast writer
GROQ_API_KEY=
# Paid, optional: ChatGPT and Perplexity as live engines
OPENAI_API_KEY=
PERPLEXITY_API_KEY=
ANTHROPIC_API_KEY=
# Optional: force the writing model: gemini | groq | openai | anthropic
# PETTLE_LLM_PROVIDER=gemini

# ---------- Google AI Overviews + AI Mode, and live Google rankings (pick one) ----------
# DataForSEO (pay as you go, ~$0.002 per search; preferred when both are set)
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# SerpApi (free tier: 250 searches/month)
SERPAPI_KEY=

# ---------- Accounts, database, scheduled checks ----------
# Postgres. Without it the app runs with no accounts and keeps everything in the browser.
# Local: postgres://whitepetal:whitepetal@127.0.0.1:5432/whitepetal  (docker compose up db)
DATABASE_URL=
# Signs sessions and encrypts integration keys at rest. 32+ random characters: openssl rand -hex 32
APP_SECRET=
# Cloud Scheduler sends this in x-cron-secret to POST /api/cron/tick
CRON_SECRET=
# Optional invite code: when set, sign-up asks for it
ACCESS_CODE=
# Public URL, used for OAuth redirects and links in Slack messages
PUBLIC_ORIGIN=http://localhost:3000

# ---------- Integrations ----------
# Google Search Console + GA4: an OAuth "Web application" client from console.cloud.google.com/apis/credentials
# Redirect URI: <PUBLIC_ORIGIN>/api/oauth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# FREE: Knowledge Graph Search API key (entity check). Same Google Cloud project, "API key"
GOOGLE_API_KEY=
# Bing Webmaster, IndexNow, Cloudflare and Slack are connected per brand in Settings, not here.
